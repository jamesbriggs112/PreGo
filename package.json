{
  "name": "prego",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Automated UX, UI and accessibility audit tool",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/server"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/server",
    "start": "node packages/server/dist/main.js",
    "typecheck": "tsc -b packages/core packages/cli packages/server",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prego": "tsx --conditions=development packages/cli/src/cli.ts",
    "fixtures": "tsx --conditions=development scripts/serve-fixtures.ts",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
