{
  "name": "@prego/core",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Prego audit engine: crawl, explore, checks, tickets, exports",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "development": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./profiles": {
      "types": "./dist/browser/profiles.d.ts",
      "development": "./src/browser/profiles.ts",
      "default": "./dist/browser/profiles.js"
    },
    "./layout": {
      "types": "./dist/explore/layout.d.ts",
      "development": "./src/explore/layout.ts",
      "default": "./dist/explore/layout.js"
    },
    "./estimate": {
      "types": "./dist/checks/estimate.d.ts",
      "development": "./src/checks/estimate.ts",
      "default": "./dist/checks/estimate.js"
    },
    "./report-options": {
      "types": "./dist/export/report-options.d.ts",
      "development": "./src/export/report-options.ts",
      "default": "./dist/export/report-options.js"
    }
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@crawlee/memory-storage": "^3.18.2",
    "@crawlee/playwright": "^3.18.2",
    "@crawlee/utils": "^3.18.2",
    "@cspell/dict-en-gb-mit": "^3.1.32",
    "@tgwf/co2": "^0.19.0",
    "accessibility-checker-engine": "^4.0.34",
    "axe-core": "^4.14.0",
    "better-sqlite3": "^13.0.3",
    "csp_evaluator": "^1.1.8",
    "cspell-trie-lib": "^10.4.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "docx": "^9.15.0",
    "html-validate": "^11.17.0",
    "jszip": "^3.10.2",
    "lighthouse": "^13.6.0",
    "playwright": "^1.64.1",
    "retire": "^6.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  }
}
