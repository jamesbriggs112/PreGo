<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Prego Dashboard - Full Accessibility Details</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h3 class="text-center text-3xl font-bold my-6">Full Accessibility Details</h3>
    <p class="text-center text-lg mb-4">Results for URL: <strong><%= results.pageUrl %></strong></p>
    
    <!-- Detailed Grouped Issues -->
    <% if (results.issues && results.issues.length > 0) { %>
      <% Object.keys(results.groupedIssues).forEach(function(code) { 
           let issues = results.groupedIssues[code]; %>
        <div class="bg-white shadow rounded p-4 mb-4">
          <h4 class="text-xl font-bold">Code: <%= code %> (Total: <%= issues.length %>)</h4>
          <ul class="list-disc pl-5">
            <% issues.forEach(function(issue, index) { %>
              <li>
                <strong><%= index + 1 %>.</strong> <%= issue.message %>
                <br>
                <em>Selector:</em> <%= issue.selector %>
                <% if (issue.wcagLevel) { %>
                  <br>
                  <em>WCAG Level:</em> <%= issue.wcagLevel %>
                <% } %>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } else { %>
      <div class="bg-green-100 text-green-700 p-4 rounded text-center">
        No accessibility issues found!
      </div>
    <% } %>
    
    <!-- Navigation -->
    <div class="text-center my-8">
      <a href="/results" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 inline-block mr-2">
        Back to Summary
      </a>
      <a href="/" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
        Run Another Test
      </a>
    </div>
  </div>
</body>
</html>