<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Prego Dashboard - Full Meta Data Details</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h3 class="text-center text-3xl font-bold my-6">Full Meta Data Details</h3>
    
    <% if (meta) { %>
      <div class="bg-white shadow-md rounded p-6 mb-8">
        <!-- Google Search Preview -->
        <h4 class="text-xl font-bold mb-2">Google Search Preview</h4>
        <div class="border p-4 mb-4">
          <h5 class="text-lg font-semibold text-blue-800"><%= meta.metaTitle %></h5>
          <p class="text-gray-600"><%= meta.metaDescription %></p>
          <p class="text-gray-500 text-sm"><%= meta.metaViewport %> - Favicon: <%= meta.favicon %></p>
        </div>
        <!-- Social Media Preview -->
        <h4 class="text-xl font-bold mb-2">Social Media Preview</h4>
        <div class="border p-4">
          <% if (meta.ogImage !== 'Not found') { %>
            <img src="<%= meta.ogImage %>" alt="OG Image" class="mb-2 w-full max-h-48 object-contain">
          <% } else { %>
            <p class="text-gray-600 mb-2">No OG Image available.</p>
          <% } %>
          <h5 class="text-lg font-semibold text-blue-800"><%= meta.ogTitle %></h5>
          <p class="text-gray-600"><%= meta.ogDescription %></p>
          <% if (meta.ogVideo !== 'Not found') { %>
            <p class="mt-2 text-gray-600">OG Video: <%= meta.ogVideo %></p>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="bg-red-100 text-red-700 p-4 rounded text-center">
        No meta data found.
      </div>
    <% } %>
    
    <!-- Navigation -->
    <div class="text-center my-8">
      <a href="/results" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 inline-block mr-2">
        Back to Summary
      </a>
      <a href="/" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
        Run Another Test
      </a>
    </div>
  </div>
</body>
</html>