<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Prego Dashboard - Results Summary</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .progress-circle {
      width: 6rem;
      height: 6rem;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h3 class="text-center text-3xl font-bold my-6">Prego Dashboard - Results Summary</h3>
    <p class="text-center text-lg mb-4">Results for URL: <strong><%= results.pageUrl %></strong></p>

    <!-- Panel 1: Accessibility Summary -->
    <div class="bg-white shadow-md rounded p-6 mb-8">
      <h4 class="text-2xl font-bold mb-4">Accessibility Summary</h4>
      <!-- (Score removed as requested) -->
      <!-- WCAG Level Summary Boxes -->
      <div class="flex flex-wrap justify-around">
        <div class="w-full md:w-1/3 p-2">
          <div class="bg-red-500 text-white rounded p-4 text-center">
            <h4 class="text-2xl font-bold">AAA</h4>
            <p class="text-lg"><%= results.summary.levelAAA %> issues</p>
          </div>
        </div>
        <div class="w-full md:w-1/3 p-2">
          <div class="bg-orange-500 text-white rounded p-4 text-center">
            <h4 class="text-2xl font-bold">AA</h4>
            <p class="text-lg"><%= results.summary.levelAA %> issues</p>
          </div>
        </div>
        <div class="w-full md:w-1/3 p-2">
          <div class="bg-gray-500 text-white rounded p-4 text-center">
            <h4 class="text-2xl font-bold">A</h4>
            <p class="text-lg"><%= results.summary.levelA %> issues</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-4">
        <a href="/accessibility-details" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
          View Full Accessibility Details
        </a>
      </div>
    </div>

    <!-- Panel 2: Meta Data Summary -->
    <div class="bg-white shadow-md rounded p-6 mb-8">
      <h4 class="text-2xl font-bold mb-4">Meta Data Summary</h4>
      <% if (results.metaData) { %>
        <div class="flex items-center space-x-4">
          <% if (results.metaData.ogImage && results.metaData.ogImage !== 'Not found') { %>
            <img src="<%= results.metaData.ogImage %>" alt="OG Image" class="w-24 h-24 object-contain rounded">
          <% } else { %>
            <div class="w-24 h-24 bg-gray-200 flex items-center justify-center rounded">
              <span class="text-gray-500 text-sm">No Image</span>
            </div>
          <% } %>
          <% if (results.metaData.favicon && results.metaData.favicon !== 'Not found') { %>
            <img src="<%= results.metaData.favicon %>" alt="Favicon" class="w-8 h-8">
          <% } else { %>
            <div class="w-8 h-8 bg-gray-200 flex items-center justify-center">
              <span class="text-gray-500 text-xs">No Favicon</span>
            </div>
          <% } %>
        </div>
        <div class="mt-4">
          <p><strong>Title:</strong> <%= results.metaData.metaTitle %></p>
          <p><strong>Description:</strong> <%= results.metaData.metaDescription %></p>
        </div>
      <% } else { %>
        <p>No meta data found.</p>
      <% } %>
      <div class="text-center mt-4">
        <a href="/meta-details" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
          View Full Meta Data Details
        </a>
      </div>
    </div>

    <!-- Panel 3: Security Summary -->
    <div class="bg-white shadow-md rounded p-6 mb-8">
      <h4 class="text-2xl font-bold mb-4">Security Summary</h4>
      <% if (results.securitySummary) { %>
        <div class="flex flex-col items-center">
          <!-- Grade Box -->
          <div class="w-20 h-20 flex items-center justify-center border-2 border-gray-400 rounded mb-4">
            <% 
              let gradeColor = 'text-gray-700';
              if (results.securitySummary.letterGrade.startsWith('A')) gradeColor = 'text-green-600';
              else if (results.securitySummary.letterGrade.startsWith('B')) gradeColor = 'text-yellow-600';
              else if (results.securitySummary.letterGrade.startsWith('C')) gradeColor = 'text-orange-600';
              else if (results.securitySummary.letterGrade.startsWith('D')) gradeColor = 'text-orange-700';
              else gradeColor = 'text-red-700';
            %>
            <span class="text-3xl font-bold <%= gradeColor %>"><%= results.securitySummary.letterGrade %></span>
          </div>
          <p class="mb-2"><strong>Security Score:</strong> <%= results.securitySummary.score %>/100</p>
          <p class="mb-2"><strong>Tests Passed:</strong> <%= results.securitySummary.passedCount %>/<%= results.securitySummary.totalChecks %></p>
        </div>
      <% } else { %>
        <p class="text-center">No security checks performed.</p>
      <% } %>
      <!-- Always show the button -->
      <div class="text-center mt-4">
        <a href="/security-details" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
          View Full Security Details
        </a>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="text-center my-8">
      <a href="/download" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block mr-2">
        Download PDF Report
      </a>
      <a href="/" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 inline-block">
        Run Another Test
      </a>
    </div>
  </div>
</body>
</html>