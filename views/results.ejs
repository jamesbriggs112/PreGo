<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Prego Dashboard - Test Results</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Optional: Adjust the size of the circular progress chart */
    .progress-circle {
      width: 6rem;
      height: 6rem;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h3 class="text-center text-3xl font-bold my-6">Prego Accessibility Test Results</h3>
    <p class="text-center text-lg mb-4">Results for URL: <strong><%= results.pageUrl %></strong></p>

    <!-- Circular Progress Score -->
    <% 
      // Determine fill color based on score thresholds
      let circleColor = '#10B981'; // green (90-100)
      if (results.score < 40) {
        circleColor = '#EF4444'; // red
      } else if (results.score < 70) {
        circleColor = '#F97316'; // orange
      } else if (results.score < 90) {
        circleColor = '#FACC15'; // yellow
      }
      const fillPercent = results.score; // Use score (0-100) as percentage
    %>
    <div class="flex justify-center mb-8">
      <div class="relative flex items-center justify-center progress-circle">
        <!-- Circular progress with conic gradient -->
        <div 
          class="w-full h-full rounded-full"
          style="background: conic-gradient(<%= circleColor %> <%= fillPercent %>%, #e2e8f0 0);">
        </div>
        <!-- Centered score text -->
        <span class="absolute font-bold text-xl">
          <%= results.score %>/100
        </span>
      </div>
    </div>

    <!-- WCAG Level Summary Boxes -->
    <div class="flex flex-wrap justify-around mb-8">
      <!-- AAA Box (Red) -->
      <div class="w-full md:w-1/3 p-2">
        <div class="bg-red-500 text-white rounded p-4 text-center">
          <h4 class="text-2xl font-bold">AAA</h4>
          <p class="text-lg"><%= results.summary.levelAAA %> issues</p>
        </div>
      </div>
      <!-- AA Box (Orange) -->
      <div class="w-full md:w-1/3 p-2">
        <div class="bg-orange-500 text-white rounded p-4 text-center">
          <h4 class="text-2xl font-bold">AA</h4>
          <p class="text-lg"><%= results.summary.levelAA %> issues</p>
        </div>
      </div>
      <!-- A Box (Gray) -->
      <div class="w-full md:w-1/3 p-2">
        <div class="bg-gray-500 text-white rounded p-4 text-center">
          <h4 class="text-2xl font-bold">A</h4>
          <p class="text-lg"><%= results.summary.levelA %> issues</p>
        </div>
      </div>
    </div>

    <!-- Additional Summary and Details -->
    <div class="bg-white shadow-md rounded p-6 mb-8">
      <p><strong>Date Tested:</strong> <%= new Date(results.dateTested).toLocaleString() %></p>
    </div>

    <!-- Grouped Issues Section -->
    <% if (results.issues && results.issues.length > 0) { %>
      <% Object.keys(results.groupedIssues).forEach(function(code) { 
           let issues = results.groupedIssues[code]; %>
        <div class="bg-white shadow rounded p-4 mb-4">
          <h4 class="text-xl font-bold">Code: <%= code %> (Total: <%= issues.length %>)</h4>
          <ul class="list-disc pl-5">
            <% issues.forEach(function(issue, index) { %>
              <li>
                <strong><%= index + 1 %>.</strong> <%= issue.message %>
                <br>
                <em>Selector:</em> <%= issue.selector %>
                <% if (issue.wcagLevel) { %>
                  <br>
                  <em>WCAG Level:</em> <%= issue.wcagLevel %>
                <% } %>
              </li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    <% } else { %>
      <div class="bg-green-100 text-green-700 p-4 rounded text-center">
        No accessibility issues found!
      </div>
    <% } %>

    <!-- Action Buttons -->
    <div class="text-center my-8">
      <a href="/download" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block mr-2">Download PDF Report</a>
      <a href="/" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 inline-block">Run Another Test</a>
    </div>
  </div>
</body>
</html>