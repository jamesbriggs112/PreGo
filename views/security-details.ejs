<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Prego Dashboard - Full Security Details</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Tippy.js CSS -->
  <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
  <style>
    /* Optional: Custom tooltip styles if needed */
  </style>
</head>
<body class="bg-gray-100">
  <div class="container mx-auto p-4">
    <h3 class="text-center text-3xl font-bold my-6">Full Security Details</h3>
    
    <!-- Minimal header similar to summary -->
    <div class="bg-white shadow-md rounded p-6 mb-6">
      <p class="text-lg">Below are the detailed results for the security header checks.</p>
    </div>
    
    <% if (results.securitySummary) { %>
      <div class="bg-white shadow-md rounded p-6 mb-8">
        <p class="mb-2"><strong>Security Score:</strong> <%= results.securitySummary.score %>/100</p>
        <p class="mb-2"><strong>Letter Grade:</strong> <%= results.securitySummary.letterGrade %></p>
        <p class="mb-4"><strong>Tests Passed:</strong> <%= results.securitySummary.passedCount %> out of <%= results.securitySummary.totalChecks %></p>
        <!-- Security Checks Table with Tippy.js tooltips -->
        <table class="min-w-full bg-white border">
          <thead>
            <tr>
              <th class="py-2 px-4 border-b text-left">Header Check</th>
              <th class="py-2 px-4 border-b text-left">Status</th>
              <th class="py-2 px-4 border-b text-left">Value</th>
            </tr>
          </thead>
          <tbody>
            <% 
              // Mapping check keys to explanation text for tooltips.
              const checkExplanations = {
                csp: "Content Security Policy (CSP) restricts content sources to help mitigate XSS attacks.",
                sts: "Strict-Transport-Security (STS) enforces HTTPS connections, reducing the risk of man-in-the-middle attacks.",
                xfo: "X-Frame-Options prevents clickjacking by stopping your site from being embedded in a frame."
              };
            %>
            <% for (const key in results.securitySummary.checks) { %>
              <tr>
                <td class="py-2 px-4 border-b" data-tippy-content="<%= checkExplanations[key] || 'No explanation available.' %>">
                  <%= key.toUpperCase() %>
                </td>
                <td class="py-2 px-4 border-b">
                  <% if (results.securitySummary.checks[key]) { %>
                    <span class="text-green-600 font-bold">Passed</span>
                  <% } else { %>
                    <span class="text-red-600 font-bold">Failed</span>
                  <% } %>
                </td>
                <td class="py-2 px-4 border-b">
                  <% if (results.securityHeaders && results.securityHeaders[key]) { %>
                    <%= results.securityHeaders[key].join(', ') %>
                  <% } else { %>
                    <em>Not present</em>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="bg-red-100 text-red-700 p-4 rounded mb-8">
        No security summary available.
      </div>
    <% } %>
    
    <% if (results.securityHeaders) { %>
      <div class="bg-white shadow-md rounded p-6 mb-8">
        <h4 class="text-xl font-bold mb-4">Raw Response Headers</h4>
        <table class="min-w-full bg-white border">
          <thead>
            <tr>
              <th class="py-2 px-4 border-b text-left">Header</th>
              <th class="py-2 px-4 border-b text-left">Value(s)</th>
            </tr>
          </thead>
          <tbody>
            <% for (const header in results.securityHeaders) { %>
              <tr>
                <td class="py-2 px-4 border-b"><%= header %></td>
                <td class="py-2 px-4 border-b"><%= results.securityHeaders[header].join(', ') %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="text-left my-8">
      <a href="/results" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 inline-block mr-2">
        Back to Summary
      </a>
      <a href="/" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 inline-block">
        Run Another Test
      </a>
    </div>
  </div>

  <!-- Tippy.js Scripts -->
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>
  <script>
    // Initialize Tippy on all elements with a data-tippy-content attribute
    tippy('[data-tippy-content]');
  </script>
</body>
</html>